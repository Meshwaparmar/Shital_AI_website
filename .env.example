# Set this to the final production domain, without a trailing slash.
NEXT_PUBLIC_SITE_URL=

# Public WhatsApp destination for the floating enquiry button, as E.164 digits
# without the leading + or punctuation. This overrides the verified fallback.
NEXT_PUBLIC_WHATSAPP_NUMBER=919033389898
