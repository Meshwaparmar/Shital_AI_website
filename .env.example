# Public canonical origin used by metadata, sitemap, robots.txt, and JSON-LD.
# Set this to the final production domain, without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://example.com

# Server-only HTTPS endpoint that receives validated business-enquiry JSON.
CONTACT_FORM_WEBHOOK_URL=https://example.com/contact-webhook

# Optional bearer token sent only by the server when calling the webhook.
CONTACT_FORM_WEBHOOK_AUTH_TOKEN=replace-with-a-secret-token
